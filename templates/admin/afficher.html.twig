{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1>Utilisateurs (Passagers et Conducteurs)</h1>

        <table class="table table-striped table-bordered mt-3">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Alerte</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.name }}</td>
                        <td>
                            {% if 'ROLE_PASSAGER' in user.roles %}
                                Passager
                            {% elseif 'ROLE_CONDUCTEUR' in user.roles %}
                                Conducteur
                            {% else %}
                                Inconnu
                            {% endif %}
                        </td>
                        <td>{{ user.alerte }}</td>
                        <td>
                            <form action="{{ path('admin_alert_user', {id: user.id}) }}" method="post">
                                <button type="submit" class="btn btn-warning btn-sm">Alerte</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
