{% extends 'base.html.twig' %}
{% block title %}Connexion — Tri9na{% endblock %}

{% block styles %}
<style>
    .login-page {
        min-height: calc(100vh - 68px - 60px);
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    /* ---- Panneau gauche : visuel ---- */
    .login-visual {
        background: linear-gradient(145deg, #0d1f14 0%, #1a6b3c 60%, #25a25a 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 50px;
        position: relative;
        overflow: hidden;
    }

    .login-visual::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .login-visual .visual-icon {
        font-size: 5rem;
        margin-bottom: 28px;
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-12px); }
    }

    .login-visual h2 {
        font-family: 'Syne', sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: white;
        text-align: center;
        line-height: 1.2;
        margin-bottom: 16px;
    }

    .login-visual h2 span { color: #f0a500; }

    .login-visual p {
        color: rgba(255,255,255,0.7);
        font-size: 1rem;
        text-align: center;
        line-height: 1.6;
        max-width: 340px;
    }

    .login-visual .stats {
        display: flex;
        gap: 32px;
        margin-top: 40px;
    }

    .login-visual .stat {
        text-align: center;
        color: white;
    }

    .login-visual .stat-num {
        font-family: 'Syne', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: #f0a500;
    }

    .login-visual .stat-lbl {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.6);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ---- Panneau droit : formulaire ---- */
    .login-form-side {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 50px;
        background: #f4f7f5;
    }

    .login-box {
        width: 100%;
        max-width: 420px;
    }

    .login-box .login-header {
        margin-bottom: 36px;
    }

    .login-box .login-header h1 {
        font-family: 'Syne', sans-serif;
        font-size: 1.9rem;
        font-weight: 800;
        color: #0d1f14;
        margin-bottom: 6px;
    }

    .login-box .login-header p {
        color: #6b8070;
        font-size: 0.92rem;
    }

    .login-box .form-group {
        margin-bottom: 20px;
    }

    .login-box label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1c2e22;
        margin-bottom: 7px;
        letter-spacing: 0.2px;
    }

    .login-box .input-wrap {
        position: relative;
    }

    .login-box .input-wrap i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #6b8070;
        font-size: 0.95rem;
    }

    .login-box input[type="email"],
    .login-box input[type="password"] {
        width: 100%;
        padding: 12px 14px 12px 40px;
        border: 1.5px solid #dde5e0;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem;
        background: white;
        color: #1c2e22;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

    .login-box input:focus {
        border-color: #1a6b3c;
        box-shadow: 0 0 0 3px rgba(26,107,60,0.12);
    }

    .login-box .remember-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .login-box .remember-row label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.88rem;
        color: #6b8070;
        font-weight: 400;
        margin: 0;
        cursor: pointer;
    }

    .login-box .remember-row input[type="checkbox"] {
        width: 16px; height: 16px;
        accent-color: #1a6b3c;
        cursor: pointer;
    }

    .btn-login {
        width: 100%;
        padding: 13px;
        background: #1a6b3c;
        color: white;
        border: none;
        border-radius: 10px;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        letter-spacing: 0.3px;
    }

    .btn-login:hover {
        background: #25a25a;
        transform: translateY(-1px);
    }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
        color: #aab8b0;
        font-size: 0.82rem;
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #dde5e0;
    }

    .register-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .register-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 14px;
        border: 1.5px solid #dde5e0;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s;
        background: white;
    }

    .register-link:hover {
        border-color: #1a6b3c;
        background: #f0f9f4;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(26,107,60,0.1);
    }

    .register-link i {
        font-size: 1.3rem;
        color: #1a6b3c;
    }

    .register-link .rl-title {
        font-weight: 600;
        font-size: 0.85rem;
        color: #1c2e22;
    }

    .register-link .rl-sub {
        font-size: 0.75rem;
        color: #6b8070;
    }

    .alert-login {
        background: #fdf0f0;
        border: 1px solid #f5c6c6;
        border-left: 4px solid #dc3545;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 20px;
        font-size: 0.88rem;
        color: #721c24;
    }

    @media (max-width: 768px) {
        .login-page { grid-template-columns: 1fr; }
        .login-visual { display: none; }
        .login-form-side { padding: 40px 24px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="login-page">

    {# ---- Panneau visuel gauche ---- #}
    <div class="login-visual">
        <div class="visual-icon">🚗</div>
        <h2>Voyagez ensemble,<br><span>économisez plus</span></h2>
        <p>La plateforme de covoiturage #1 en Tunisie. Trouvez un trajet ou proposez le vôtre en quelques clics.</p>
        <div class="stats">
            <div class="stat">
                <div class="stat-num">500+</div>
                <div class="stat-lbl">Trajets/mois</div>
            </div>
            <div class="stat">
                <div class="stat-num">1200+</div>
                <div class="stat-lbl">Utilisateurs</div>
            </div>
            <div class="stat">
                <div class="stat-num">24</div>
                <div class="stat-lbl">Gouvernorats</div>
            </div>
        </div>
    </div>

    {# ---- Formulaire de connexion ---- #}
    <div class="login-form-side">
        <div class="login-box">
            <div class="login-header">
                <h1>Bon retour 👋</h1>
                <p>Connectez-vous pour accéder à votre espace</p>
            </div>

            {% if error %}
                <div class="alert-login">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% for message in app.flashes('error') %}
                <div class="alert-login">
                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                </div>
            {% endfor %}

            <form method="post">
                <div class="form-group">
                    <label for="inputEmail">Adresse e-mail</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope"></i>
                        <input type="email"
                               value="{{ last_username }}"
                               name="email"
                               id="inputEmail"
                               placeholder="votre@email.com"
                               autocomplete="email"
                               required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label for="inputPassword">Mot de passe</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password"
                               name="password"
                               id="inputPassword"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="remember-row">
                    <label>
                        <input type="checkbox" name="_remember_me">
                        Se souvenir de moi
                    </label>
                </div>

                <button class="btn-login" type="submit">
                    <i class="fas fa-sign-in-alt"></i> Se connecter
                </button>
            </form>

            <div class="divider">Pas encore de compte ?</div>

            <div class="register-links">
                <a href="{{ path('register_passager') }}" class="register-link">
                    <i class="fas fa-user"></i>
                    <span class="rl-title">Passager</span>
                    <span class="rl-sub">Je cherche un trajet</span>
                </a>
                <a href="{{ path('register_conducteur') }}" class="register-link">
                    <i class="fas fa-car"></i>
                    <span class="rl-title">Conducteur</span>
                    <span class="rl-sub">Je propose un trajet</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}