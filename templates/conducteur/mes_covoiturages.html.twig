{% extends 'base.html.twig' %}

{% block title %}Mes covoiturages - Tri9na{% endblock %}

{% block styles %}
<style>
    .covoiturages-header {
        background: linear-gradient(135deg, #0d1f14 0%, #1a6b3c 100%);
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }
    .covoiturages-header h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.8rem;
        margin: 0;
    }
    .covoiturages-header p {
        opacity: 0.85;
        margin: 0.25rem 0 0;
    }
    .btn-new-trajet {
        background: var(--accent);
        color: var(--dark);
        border: none;
        border-radius: 40px;
        padding: 0.7rem 1.5rem;
        font-weight: 700;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-new-trajet:hover {
        background: #f5b81b;
        transform: translateY(-2px);
        color: var(--dark);
    }

    /* Table moderne */
    .trajets-table {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow);
        width: 100%;
        border-collapse: collapse;
    }
    .trajets-table thead tr {
        background: var(--dark);
        color: white;
    }
    .trajets-table th {
        padding: 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
    }
    .trajets-table td {
        padding: 1rem;
        border-bottom: 1px solid #eef2f0;
        vertical-align: middle;
    }
    .trajets-table tbody tr:hover {
        background: #f9fbf9;
    }
    .badge-places {
        background: #f0f7f3;
        color: var(--primary);
        border-radius: 40px;
        padding: 4px 12px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
    }
    .badge-sature {
        background: #f8d7da;
        color: #721c24;
    }
    .btn-icon {
        background: none;
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-edit {
        background: rgba(26,107,60,0.1);
        color: var(--primary);
    }
    .btn-edit:hover {
        background: var(--primary);
        color: white;
    }
    .btn-delete {
        background: rgba(220,53,69,0.1);
        color: #dc3545;
    }
    .btn-delete:hover {
        background: #dc3545;
        color: white;
    }
    .empty-state {
        text-align: center;
        padding: 3rem;
        background: white;
        border-radius: 24px;
        color: var(--muted);
    }
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
    @media (max-width: 768px) {
        .covoiturages-header { flex-direction: column; text-align: center; gap: 1rem; }
        .trajets-table, .trajets-table tbody, .trajets-table tr, .trajets-table td {
            display: block;
            width: 100%;
        }
        .trajets-table thead { display: none; }
        .trajets-table tr {
            margin-bottom: 1rem;
            border: 1px solid #eef2f0;
            border-radius: 16px;
            padding: 1rem;
        }
        .trajets-table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eef2f0;
            padding: 0.75rem 0;
        }
        .trajets-table td:last-child { border-bottom: none; }
        .trajets-table td::before {
            content: attr(data-label);
            font-weight: 700;
            color: var(--dark);
            width: 40%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="covoiturages-header">
        <div>
            <h1>🚗 Mes covoiturages</h1>
            <p>Gérez vos trajets publiés, modifiez ou supprimez-les</p>
        </div>
        <a href="{{ path('app_covoiturage') }}" class="btn-new-trajet">
            <i class="fas fa-plus-circle"></i> Nouveau trajet
        </a>
    </div>

    {% if covoiturages is empty %}
        <div class="empty-state">
            <i class="fas fa-road"></i>
            <p>Vous n’avez encore publié aucun covoiturage.</p>
            <a href="{{ path('app_covoiturage') }}" class="btn-t-primary mt-3">
                <i class="fas fa-plus"></i> Créer mon premier trajet
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="trajets-table">
                <thead>
                    <tr>
                        <th>Départ</th>
                        <th>Destination</th>
                        <th>Places</th>
                        <th>Date & heure</th>
                        <th>Véhicule</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for covoiturage in covoiturages %}
                        <tr>
                            <td data-label="Départ">
                                <strong>{{ covoiturage.villedeDepart }}</strong>
                            </td>
                            <td data-label="Destination">
                                {{ covoiturage.villeArriver }}
                            </td>
                            <td data-label="Places">
                                <span class="badge-places {{ covoiturage.staurer ? 'badge-sature' : '' }}">
                                    <i class="fas fa-chair"></i>
                                    {{ covoiturage.staurer ? 'Complet' : covoiturage.nbplace ~ ' place(s)' }}
                                </span>
                            </td>
                            <td data-label="Date">
                                {{ covoiturage.date|date('d/m/Y H:i') }}
                            </td>
                            <td data-label="Véhicule">
                                {{ covoiturage.vehicule.type }}
                            </td>
                            <td data-label="Actions">
                                <a href="{{ path('app_covoiturage_modifier', { id: covoiturage.id }) }}" class="btn-icon btn-edit">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <a href="{{ path('app_covoiturage_suprimer', { id: covoiturage.id }) }}" class="btn-icon btn-delete ms-2" onclick="return confirm('Supprimer ce covoiturage ?')">
                                    <i class="fas fa-trash-alt"></i> Supprimer
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}