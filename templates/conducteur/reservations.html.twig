{% extends 'base.html.twig' %}

{% block title %}Gérer les réservations - Tri9na{% endblock %}

{% block styles %}
<style>
    .page-header {
        background: linear-gradient(135deg, #0d1f14 0%, #1a6b3c 100%);
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        text-align: center;
    }
    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }
    .page-header p {
        opacity: 0.85;
        font-size: 0.95rem;
    }

    /* Table moderne */
    .reservations-table {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow);
        width: 100%;
        border-collapse: collapse;
    }
    .reservations-table thead tr {
        background: var(--dark);
        color: white;
    }
    .reservations-table th {
        padding: 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
        position: sticky;
        top: 0;
        background: var(--dark);
    }
    .reservations-table td {
        padding: 1rem;
        border-bottom: 1px solid #eef2f0;
        vertical-align: middle;
    }
    .reservations-table tbody tr:hover {
        background: #f9fbf9;
    }

    /* Badges de statut */
    .status-badge {
        padding: 6px 14px;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
    }
    .status-attente {
        background: #fff3cd;
        color: #856404;
    }
    .status-valide {
        background: #d4edda;
        color: #155724;
    }
    .status-refuse {
        background: #f8d7da;
        color: #721c24;
    }

    /* Boutons d'action */
    .btn-action {
        padding: 6px 14px;
        border-radius: 40px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
        border: none;
        cursor: pointer;
    }
    .btn-valider {
        background: #27ae60;
        color: white;
    }
    .btn-valider:hover {
        background: #2ecc71;
        transform: translateY(-2px);
    }
    .btn-refuser {
        background: #e74c3c;
        color: white;
    }
    .btn-refuser:hover {
        background: #c0392b;
        transform: translateY(-2px);
    }
    .btn-disabled {
        background: #bdc3c7;
        color: #7f8c8d;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Message vide */
    .empty-state {
        text-align: center;
        padding: 3rem;
        background: white;
        border-radius: 24px;
        color: var(--muted);
    }
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .reservations-table, .reservations-table tbody, .reservations-table tr, .reservations-table td {
            display: block;
            width: 100%;
        }
        .reservations-table thead {
            display: none;
        }
        .reservations-table tr {
            margin-bottom: 1rem;
            border: 1px solid #eef2f0;
            border-radius: 16px;
            padding: 1rem;
            background: white;
        }
        .reservations-table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eef2f0;
            padding: 0.75rem 0;
        }
        .reservations-table td:last-child {
            border-bottom: none;
        }
        .reservations-table td::before {
            content: attr(data-label);
            font-weight: 700;
            color: var(--dark);
            width: 40%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="page-header">
        <h1>📋 Gérer les réservations</h1>
        <p>Consultez et validez les demandes des passagers pour vos trajets</p>
    </div>

    {% if reservations is empty %}
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>Aucune réservation pour le moment.</p>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="reservations-table">
                <thead>
                    <tr>
                        <th>Passager</th>
                        <th>Téléphone</th>
                        <th>Départ</th>
                        <th>Destination</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td data-label="Passager">{{ reservation.passager.name }}</td>
                            <td data-label="Téléphone">{{ reservation.passager.numtel }}</td>
                            <td data-label="Départ">{{ reservation.covoiturage.villedeDepart }}</td>
                            <td data-label="Destination">{{ reservation.covoiturage.villeArriver }}</td>
                            <td data-label="Date">{{ reservation.covoiturage.date|date('d/m/Y H:i') }}</td>
                            <td data-label="Statut">
                                {% if reservation.etat == 'en_attente' %}
                                    <span class="status-badge status-attente">
                                        <i class="fas fa-clock"></i> En attente
                                    </span>
                                {% elseif reservation.etat == 'valide' %}
                                    <span class="status-badge status-valide">
                                        <i class="fas fa-check-circle"></i> Validée
                                    </span>
                                {% else %}
                                    <span class="status-badge status-refuse">
                                        <i class="fas fa-times-circle"></i> Refusée
                                    </span>
                                {% endif %}
                            </td>
                            <td data-label="Actions">
                                {% if reservation.etat == 'en_attente' %}
                                    <a href="{{ path('app_reservation_valider', { id: reservation.id }) }}" class="btn-action btn-valider">
                                        <i class="fas fa-check"></i> Valider
                                    </a>
                                    <a href="{{ path('app_reservation_refuser', { id: reservation.id }) }}" class="btn-action btn-refuser">
                                        <i class="fas fa-times"></i> Refuser
                                    </a>
                                {% else %}
                                    <span class="btn-action btn-disabled">
                                        <i class="fas fa-lock"></i> Aucune action
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}