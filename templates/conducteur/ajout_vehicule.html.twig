{% extends 'base.html.twig' %}

{% block title %}Ajouter un véhicule - Tri9na{% endblock %}

{% block styles %}
<style>
    .page-header {
        background: linear-gradient(135deg, #0d1f14 0%, #1a6b3c 100%);
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2rem;
        color: white;
        text-align: center;
    }
    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }
    .page-header p {
        opacity: 0.85;
        font-size: 0.95rem;
    }

    .form-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: var(--shadow);
        max-width: 700px;
        margin: 0 auto;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        border: 1.5px solid #e2e8e6;
        border-radius: 12px;
        transition: all 0.2s;
        font-family: 'DM Sans', sans-serif;
    }

    .form-control:focus {
        border-color: var(--primary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(26,107,60,0.1);
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 40px;
        padding: 0.85rem;
        font-weight: 700;
        font-size: 1rem;
        width: 100%;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-submit:hover {
        background: var(--primary-light);
        transform: translateY(-2px);
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="page-header">
        <h1>🚗 Ajouter mon véhicule</h1>
        <p>Renseignez les informations de votre voiture pour proposer des trajets</p>
    </div>

    <div class="form-card">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.type, 'Type de véhicule') }}
                {{ form_widget(form.type, { attr: { class: 'form-control', placeholder: 'Ex: Clio, 208, Golf...' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(form.nbpplace, 'Nombre de places') }}
                {{ form_widget(form.nbpplace, { attr: { class: 'form-control', placeholder: '4, 5, 7...' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(form.model, 'Modèle') }}
                {{ form_widget(form.model, { attr: { class: 'form-control', placeholder: 'Renault, Peugeot, Volkswagen...' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(form.imageFile, 'Photo du véhicule') }}
                {{ form_widget(form.imageFile, { attr: { class: 'form-control' } }) }}
            </div>
            <button type="submit" class="btn-submit">
                <i class="fas fa-save"></i> Enregistrer le véhicule
            </button>
            
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}