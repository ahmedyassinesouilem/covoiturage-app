{% extends 'base.html.twig' %}

{% block title %}Passager{% endblock %}

{% block body %}
<div class="background-image">
    <div class="container mt-5">
        <h1 class="text-dark">Bienvenue {{ app.user.name }},</h1>
        <p class="text-center text-muted">Voici votre tableau de bord Passager</p>

        <div class="content-section mt-4">
            <div class="info-left">
                <h2>Mes Informations</h2>
                <p><strong>Nom :</strong> {{ app.user.name }}</p>
                <p><strong>Email :</strong> {{ app.user.email }}</p>
                <p><strong>Numéro de téléphone :</strong> {{ app.user.numtel }}</p>
                <div class="mt-4 text-center">
                    <a href="{{ path('app_covoiturage_disponible') }}" class="btn btn-primary">Voir les Covoiturages Disponibles</a>
                </div>
            </div>
        </div>
    </div>
</div>




<style>
    /* Arrière-plan avec image */
    .background-image {
        position: relative;
        min-height: 100vh;
        padding: 50px 0;
    }

    .background-image::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('/images/passager.jpg') no-repeat center center fixed;
        background-size: cover;
        opacity: 0.3; /* Rendre l'image moins visible */
        filter: blur(5px); /* Ajouter un flou */
        z-index: 1;
    }

    /* Superposition pour le contenu */
    .container {
        position: relative;
        z-index: 2;
        max-width: 800px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.85); /* Fond blanc translucide */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    /* En-tête */
    h1 {
        font-size: 2.5rem;
        color: #333; /* Gris foncé */
        text-align: center;
        margin-bottom: 10px;
    }

    p.text-center {
        font-size: 1.2rem;
        color: #555; /* Gris moyen pour contraste */
        margin-bottom: 20px;
    }

    /* Section principale */
    .content-section {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    h2 {
        font-size: 1.8rem;
        color: #2980b9;
        margin-bottom: 15px;
    }

    p {
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 10px;
    }

    /* Boutons */
    .btn {
        display: inline-block;
        padding: 10px 20px;
        font-size: 1rem;
        text-align: center;
        text-decoration: none;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #3498db;
        color: white;
    }

    .btn-primary:hover {
        background-color: #2980b9;
    }

    /* Animation */
    .content-section:hover {
        transform: translateY(-3px);
        transition: all 0.3s ease;
    }

    /* Texte avec contraste */
    .text-dark {
        color: #333; /* Gris foncé pour "Bienvenue" */
    }

    .text-muted {
        color: #555; /* Gris moyen pour le sous-titre */
    }
</style>
{% endblock %}
